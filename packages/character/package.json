{
  "name": "@amadeus/character",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Kurisu persona, system prompt builder, mood rules, response sanitizer",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && cp -r src/prompts dist/prompts",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@amadeus/contracts": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.4"
  }
}
